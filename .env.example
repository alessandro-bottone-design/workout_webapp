# Supabase Configuration
# Sostituisci con l'URL del tuo progetto Supabase e la chiave anon pubblica
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Calendar (opzionale, SOLO lato server / Vercel Environment Variables)
# NON usare il prefisso VITE_ per non esporre l'URL segreto nel bundle client.
# Se configurato, l'app collega automaticamente questo calendario predefinito.
GOOGLE_CALENDAR_ICAL_URL=
